---
import { getCollection } from 'astro:content'
import SubtitlesEdit from '../icons/SubtitlesEdit.astro'
import Content from '../layouts/Content.astro'

const books = await getCollection('blogs')
---

<Content>
  <h2 class="text-3xl font-semibold flex items-center gap-2">
    <SubtitlesEdit /> Cursos y Resúmenes
  </h2>

  {
    books.map(book => {
      const { id: slug, data } = book
      const { title, author, img, readtime, description } = data

      return (
        <a
          class="block relative my-6 group overflow-hidden"
          href={`/blog/${slug}`}>
          <figure class="aspect-video rounded-xl overflow-hidden transition hover:scale-110">
            <img
              transition:name={`img-${slug}`}
              class="object-cover w-full h-full"
              src={`/img/blogs/${img}`}
              alt={`${title} - ${author}`}
            />
          </figure>

          <div class="p-4 text-center">
            <h3 class="text-xl font-semibold">{title}</h3>

            <p class="my-2 opacity-80 text-sm">{description}</p>

            <h6 class="mt-2 mb-4 text-xs">
              ⌛ Lectura en{' '}
              <span class="mb-2 inline-flex items-center rounded-md bg-gray-50 dark:bg-gray-400/10 px-2 py-1 text-xs font-semibold text-gray-900 dark:text-gray-300">
                {readtime}
              </span>{' '}
              minutos
            </h6>
          </div>
        </a>
      )
    })
  }
</Content>

