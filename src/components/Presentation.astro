---
import MailCodeIcon from '../icons/MailCode.astro'
import BrandGithubIcon from '../icons/BrandGithub.astro'
import BrandLinkedinIcon from '../icons/BrandLinkedin.astro'
import Content from '../layouts/Content.astro'
---

<Content>
  <h1 class="text-4xl py-2 font-bold tracking-tight">
    Soy Gary<span class="text-secondary-3">•</span>D<span class="text-secondary-3"
      >•</span
    >Guzmán
  </h1>

  <h2 class="text-2xl py-2 flex items-center gap-2">
    Ingeniero de Sistemas
    <a href="https://github.com/garyDav/" class="-mt-1">
      <span
        class="bg-secondary-4 dark:bg-surface rounded-md text-base text-secondary-4-active py-1 px-2 font-semibold"
        >FullStack
      </span>
    </a>
  </h2>

  <p class="text-lg py-4 indent-8 text-justify hyphens-auto">
    Soy <strong>Ingeniero de Sistemas</strong> con <strong>más de 10 años de experiencia</strong> en desarrollo
    de software FullStack, arquitectura backend, DevOps y ciencia de datos. Cuento con un
    <strong>Máster en Desarrollo de Aplicaciones y Servicios Web</strong> en la <em
      ><a
        class="text-secondary-2 hover:underline"
        href="https://www.universidadviu.com/int/maestria-desarrollo-web"
        >(VIU)</a
      ></em
    >. He liderado proyectos de <strong class="text-secondary-1"
      >transformación digital</strong
    > en instituciones educativas, plataformas de telemedicina y sistemas de transporte, combinando diseño
    funcional, modelado y optimización de datos SQL/NoSQL, despliegue en VPS/nube y mentoría técnica en
    desarrollo y análisis de datos.
  </p>

  <ul class="py-4 flex flex-wrap items-center justify-around">
    <a href="mailto:g.garydav@gmail.com">
      <li class="p-2 bg-secondary-3 rounded-full text-white dark:text-black">
        <MailCodeIcon class="size-10" />
      </li>
    </a>
    <a href="https://github.com/garyDav" target="_blank">
      <li class="p-2 bg-neutral-800 dark:bg-white rounded-full text-white dark:text-black">
        <BrandGithubIcon class="size-10" />
      </li>
    </a>
    <a href="https://www.linkedin.com/in/garydav/" target="_blank" rel="noopener noreferrer">
      <li class="p-2 bg-blue-400 rounded-full text-white dark:text-black">
        <BrandLinkedinIcon class="size-10" />
      </li>
    </a>
  </ul>

  <figure
    class="my-4 border-2 border-secondary-3 flex items-center justify-center w-40 h-40 mx-auto rounded-full overflow-hidden">
    <img
      src="/img/profile.webp"
      alt="My Profile"
      class="object-cover w-full h-full"
    />
  </figure>
</Content>
